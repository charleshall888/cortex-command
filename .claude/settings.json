{
  "permissions": {
    "allow": [
      "Bash(cortex-resolve-backlog-item *)",
      "Bash(just *)",
      "Bash(just)"
    ],
    "deny": [
      "Bash(just dangerous)"
    ],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/claude/hooks/cortex-skill-edit-advisor.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cortex-backlog@cortex-command": true
  }
}
