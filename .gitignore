# Worktree directories
.claude/worktrees/
worktrees/

# Local dev-server registry: machine-specific absolute paths, some pointing at
# per-session scratchpad dirs that do not outlive the session that wrote them.
.claude/launch.json

# Per-feature interactive session locks — runtime state, never committed
cortex/lifecycle/*/interactive.pid

# Runtime logs
claude/statusline.sh.log
claude/statusline.log

# Python
.venv/
*.pyc
__pycache__/

# cortex-pr-review run artifacts (regenerated on demand)
plugins/cortex-pr-review/skills/pr-review/.cache/

# Dynamic version file generated by hatch-vcs at build time
cortex_command/_version.py

# Dashboard dev artifacts
claude/dashboard/node_modules/
claude/dashboard/package-lock.json

# Obsidian workspace config
.obsidian/

# Pytest temp directories
pytest-of-*/

# OS
.DS_Store

# Environment
.env
.env.*

# Lifecycle-archive sample-run slug list (transient; written by cortex-archive-sample-select)
.archive-sample.txt
cortex/.cortex-init
cortex/.cortex-init-backup/

# Transient flock lock files written by cortex-lifecycle-event (events.log writer)
events.log.lock

# Local pipeline state (runtime artifact; was 100% dashboard-seed output when tracked)
cortex/lifecycle/pipeline-state.json
