#!/bin/bash
# .githooks/pre-commit — policy-aware dual-source drift enforcement
#
# Five phases:
#   1. Validate every plugins/*/.claude-plugin/plugin.json has a non-empty
#      .name field, and fail closed if any discovered plugin dir is not
#      classified in BUILD_OUTPUT_PLUGINS or HAND_MAINTAINED_PLUGINS.
#   1.5. When staged paths match the sandbox-source watched set, run the
#      sandbox preflight gate (named survivor per the enforcement-gates
#      constraint) against the staged blob view.
#   2. Decide whether a build is needed based on staged paths. Build is
#      needed when any staged path is a top-level source (skills/, bin/cortex-,
#      hooks/cortex-, claude/hooks/cortex-) or under a build-output plugin
#      tree. The pattern must cover every source `just build-plugin` reads —
#      out-of-sync triggers cause silent mirror drift.
#   3. When a build is needed, run `just build-plugin` to regenerate all
#      build-output plugin trees from top-level sources.
#   4. For each build-output plugin, run `git diff --quiet plugins/$p/` to
#      detect drift between the freshly-built working tree and the index.
#
# Enable with:   just setup-githooks
# Bypass once:   git commit --no-verify   (discouraged)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# -----------------------------------------------------------------------------
# Phase 1 — Name validation and classification guard
# -----------------------------------------------------------------------------
# Populate BO/HM from helper recipes. `mapfile -t` is the natural idiom but is
# unavailable in bash 3.2 (macOS system bash); use read-loop to remain
# compatible with the spec's `#!/bin/bash` shebang constraint.
BO=()
while IFS= read -r line; do
    [ -n "$line" ] && BO+=("$line")
done < <(just _list-build-output-plugins)
HM=()
while IFS= read -r line; do
    [ -n "$line" ] && HM+=("$line")
done < <(just _list-hand-maintained-plugins)

shopt -s nullglob
for pj in plugins/*/.claude-plugin/plugin.json; do
    plugin_dir="${pj#plugins/}"
    plugin_dir="${plugin_dir%%/*}"

    if ! jq -e '.name | length > 0' "$pj" >/dev/null 2>&1; then
        echo "pre-commit: $pj missing non-empty 'name' field." >&2
        exit 1
    fi

    classified=0
    for p in "${BO[@]}"; do
        if [ "$p" = "$plugin_dir" ]; then classified=1; break; fi
    done
    if [ "$classified" -eq 0 ]; then
        for p in "${HM[@]}"; do
            if [ "$p" = "$plugin_dir" ]; then classified=1; break; fi
        done
    fi
    if [ "$classified" -eq 0 ]; then
        echo "pre-commit: plugin '$plugin_dir' not classified (BUILD_OUTPUT_PLUGINS or HAND_MAINTAINED_PLUGINS)." >&2
        exit 1
    fi
done
shopt -u nullglob

# -----------------------------------------------------------------------------
# Phase 1.5 — Sandbox preflight gate (spec Req 17)
# -----------------------------------------------------------------------------
# When any staged path is one of the sandbox-source watched files, invoke the
# preflight gate. The gate itself re-checks staged hunks against the watched
# patterns (a staged path alone does not fire it) and exits non-zero when a
# sandbox-source change is staged without fresh, schema-valid preflight
# evidence; propagate that exit code so the commit is blocked.
sandbox_preflight_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        cortex_command/pipeline/dispatch.py|cortex_command/overnight/runner.py|cortex_command/overnight/sandbox_settings.py|pyproject.toml)
            sandbox_preflight_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMRD)

if [ "$sandbox_preflight_triggered" -eq 1 ]; then
    if ! just check-sandbox-preflight; then
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Phase 1.55 — Skill-prose to CLI argparse contract enforcement
# -----------------------------------------------------------------------------
# When any staged path matches the contract scan corpus (skills/, hooks/,
# justfile, docs/, tests/, CLAUDE.md, cortex/requirements/), invoke the
# contract linter against the staged blob view. The linter exits non-zero on
# any argparse drift between skill prose and CLI argument declarations;
# propagate that exit code so the commit is blocked.
contract_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        skills/*|hooks/*|justfile|docs/*|tests/*|CLAUDE.md|cortex/requirements/*)
            contract_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$contract_triggered" -eq 1 ]; then
    if ! just check-contract --staged; then
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Phase 1.6 — bin/cortex-* shim presence enforcement
# -----------------------------------------------------------------------------
# When any staged path matches ^bin/cortex-, invoke the aggregator's
# --check-shims to verify every bin/cortex-* (except the helper and aggregator
# themselves) has the cortex-log-invocation shim line in its first 50 lines.
# The aggregator's stderr (one missing-script basename per line) reaches the user.
shim_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        bin/cortex-*)
            shim_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$shim_triggered" -eq 1 ]; then
    if ! bin/cortex-invocation-report --check-shims; then
        echo "pre-commit: bin/cortex-* shim line missing — add the cortex-log-invocation shim line to each script listed above." >&2
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Phase 1.7 — backlog entry-point telemetry-call enforcement
# -----------------------------------------------------------------------------
# When any staged path is one of the four cortex_command/backlog/<mod>.py
# entry-point modules, invoke --check-entry-points to verify the first
# statement of each def main() is _telemetry.log_invocation(...). Catches
# regressions where an entry-point is added without wiring telemetry,
# preserving byte-equivalence with bin/cortex-log-invocation.
entry_points_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        cortex_command/backlog/update_item.py|cortex_command/backlog/create_item.py|cortex_command/backlog/generate_index.py|cortex_command/backlog/build_epic_map.py|cortex_command/backlog/ready.py|cortex_command/overnight/complete_morning_review_session.py|cortex_command/lifecycle/branch_mode_cli.py|cortex_command/lifecycle/picker_decision_cli.py|cortex_command/critical_review/resolve_feature_cli.py|cortex_command/critical_review/write_residue_cli.py|cortex_command/backlog/_telemetry.py)
            entry_points_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$entry_points_triggered" -eq 1 ]; then
    if ! bin/cortex-invocation-report --check-entry-points; then
        echo "pre-commit: backlog entry-point module's def main() must begin with _telemetry.log_invocation(...) — fix each module listed above." >&2
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Phase 1.86 — Bare-python cortex_command import scanner (L201, R6)
# -----------------------------------------------------------------------------
# When any staged path matches skill prose, backlog ticket bodies, or the shim
# itself, invoke the bare-python-import linter against the staged blob view.
# The linter exits non-zero when a file contains a bare `python3 -c "import
# cortex_command` or `python3 -m cortex_command` callsite without a
# <!-- bare-python-lint:ignore-next --> sentinel.
bare_python_import_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        skills/*|cortex/backlog/*.md|bin/cortex-check-bare-python-import)
            bare_python_import_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$bare_python_import_triggered" -eq 1 ]; then
    if ! just check-bare-python-import; then
        echo "pre-commit: bare-python cortex_command import check failed — convert to a cortex-* console-script call, or add the <!-- bare-python-lint:ignore-next --> sentinel if the bare-Python form is intentional." >&2
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Phase 1.87 — Skill-path resolution scanner (SP001/SP002)
# -----------------------------------------------------------------------------
# When any staged path matches skill prose, plugin trees, the detector module,
# or the wrapper itself, invoke the skill-path scanner against the staged blob
# view. The scanner exits non-zero when a raw ${CLAUDE_SKILL_DIR} token or bare
# *.md consult-ref appears inside a subagent prompt (D1/SP001), or a
# bare-relative Read/execute path is not carried by a resolved
# ${CLAUDE_SKILL_DIR}/ prefix (D2/SP002).
skill_path_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        skills/*|plugins/*|cortex_command/lint/skill_path.py|bin/cortex-check-skill-path)
            skill_path_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$skill_path_triggered" -eq 1 ]; then
    if ! just check-skill-path; then
        echo "pre-commit: skill-path check failed — body-propagate \${CLAUDE_SKILL_DIR} tokens (inline content or resolved absolute path) and prefix bare-relative Read/execute paths with \${CLAUDE_SKILL_DIR}/, or add the <!-- skill-path-lint:ignore-next --> sentinel if intentional." >&2
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Phase 1.95 — install_guard byte-identity parity (R11 / T8)
# -----------------------------------------------------------------------------
# When any staged path is the canonical install_guard, the vendored sibling, or
# the sync recipe itself, run `just sync-install-guard --check` to verify the
# vendored sibling at plugins/cortex-overnight/install_guard.py is byte-identical
# to the regenerated artifact from cortex_command/install_guard.py. Without this
# gate, an autoformatter pass on the canonical can silently drift the sibling
# and break the plugin's stdlib-only in-flight guard.
install_guard_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        cortex_command/install_guard.py|plugins/cortex-overnight/install_guard.py|justfile)
            install_guard_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$install_guard_triggered" -eq 1 ]; then
    if ! just sync-install-guard --check; then
        echo "pre-commit: install_guard parity failed — run 'just sync-install-guard' and stage plugins/cortex-overnight/install_guard.py." >&2
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Phase 1.96 — cli_pin.py structural integrity (R8)
# -----------------------------------------------------------------------------
# When the canonical CLI pin sibling is staged, verify its AST contains only a
# docstring (optional) and a single CLI_PIN = (tag, schema) 2-tuple assignment.
# Reject third-party imports, function/class definitions, top-level calls, or
# any tuple arity other than 2. The hook layer imports cli_pin.py without
# invoking server.py's side effects, so this guard locks in that invariant.
cli_pin_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        plugins/cortex-overnight/cli_pin.py)
            cli_pin_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$cli_pin_triggered" -eq 1 ]; then
    if ! python3 - <<'PYEOF'
import ast
import sys
from pathlib import Path

TARGET = Path("plugins/cortex-overnight/cli_pin.py")

try:
    source = TARGET.read_text(encoding="utf-8")
except OSError as exc:
    print(f"pre-commit: cannot read {TARGET}: {exc}", file=sys.stderr)
    sys.exit(1)

try:
    tree = ast.parse(source, filename=str(TARGET))
except SyntaxError as exc:
    print(f"pre-commit: {TARGET} failed to parse: {exc}", file=sys.stderr)
    sys.exit(1)

seen_assign = False
for node in tree.body:
    # Allow a leading docstring: ast.Expr wrapping an ast.Constant string.
    if (
        isinstance(node, ast.Expr)
        and isinstance(node.value, ast.Constant)
        and isinstance(node.value.value, str)
    ):
        continue
    # Allow exactly one top-level assignment: CLI_PIN = (<tag>, <schema>).
    if isinstance(node, ast.Assign):
        if len(node.targets) != 1 or not (
            isinstance(node.targets[0], ast.Name)
            and node.targets[0].id == "CLI_PIN"
        ):
            print(
                f"pre-commit: {TARGET} line {node.lineno}: only `CLI_PIN = (...)` "
                "is allowed at module top level.",
                file=sys.stderr,
            )
            sys.exit(1)
        if not isinstance(node.value, ast.Tuple):
            print(
                f"pre-commit: {TARGET} line {node.lineno}: CLI_PIN must be a tuple literal.",
                file=sys.stderr,
            )
            sys.exit(1)
        if len(node.value.elts) != 2:
            print(
                f"pre-commit: {TARGET} line {node.lineno}: CLI_PIN tuple must have "
                f"exactly 2 elements (got {len(node.value.elts)}).",
                file=sys.stderr,
            )
            sys.exit(1)
        if seen_assign:
            print(
                f"pre-commit: {TARGET} line {node.lineno}: only one CLI_PIN "
                "assignment is allowed.",
                file=sys.stderr,
            )
            sys.exit(1)
        seen_assign = True
        continue
    # Anything else — Import, ImportFrom, FunctionDef, ClassDef, Expr(Call), If,
    # For, With, Try, AnnAssign, AugAssign, etc. — is rejected.
    kind = type(node).__name__
    detail = ""
    if isinstance(node, (ast.Import, ast.ImportFrom)):
        names = ", ".join(
            (alias.name if isinstance(node, ast.Import) else f"{node.module or ''}.{alias.name}")
            for alias in node.names
        )
        detail = f" (import: {names})"
    print(
        f"pre-commit: {TARGET} line {node.lineno}: disallowed top-level "
        f"{kind}{detail}. Only a docstring and `CLI_PIN = (tag, schema)` are permitted.",
        file=sys.stderr,
    )
    sys.exit(1)

if not seen_assign:
    print(
        f"pre-commit: {TARGET}: missing required `CLI_PIN = (tag, schema)` assignment.",
        file=sys.stderr,
    )
    sys.exit(1)

sys.exit(0)
PYEOF
    then
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Phase 1.97 — install_core.py stdlib-only + _enforce_plugin_root parity (R10 / R13 / T9)
# -----------------------------------------------------------------------------
# When any staged path is install_core.py or server.py (the source of the
# duplicated _enforce_plugin_root), run two structural guards on
# plugins/cortex-overnight/install_core.py:
#   (a) import-allowlist: reject `cortex_command`, `packaging`, `mcp`,
#       `pydantic`, `fastmcp`. Mirrors Task 6's structural approach but uses
#       a string-list rejection (install_core.py is too rich to whitelist
#       exhaustively).
#   (b) byte-identity parity: extract the `_enforce_plugin_root` FunctionDef
#       AST node from both files, call ast.unparse on each, and compare —
#       normalizing whitespace inside the body the same way the existing
#       `just sync-install-guard --check` precedent does for its duplicated
#       function. On mismatch, name the divergent function.
install_core_triggered=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        plugins/cortex-overnight/install_core.py|plugins/cortex-overnight/server.py)
            install_core_triggered=1
            break
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$install_core_triggered" -eq 1 ]; then
    if ! python3 - <<'PYEOF'
import ast
import sys
from pathlib import Path

REPO = Path.cwd()
INSTALL_CORE = REPO / "plugins" / "cortex-overnight" / "install_core.py"
SERVER = REPO / "plugins" / "cortex-overnight" / "server.py"

FORBIDDEN_ROOTS = {"cortex_command", "packaging", "mcp", "pydantic", "fastmcp"}

if not INSTALL_CORE.exists():
    # install_core.py is not yet materialized; nothing to guard.
    sys.exit(0)

install_core_src = INSTALL_CORE.read_text(encoding="utf-8")
try:
    install_core_tree = ast.parse(install_core_src, filename=str(INSTALL_CORE))
except SyntaxError as exc:
    print(
        f"pre-commit: install_core.py failed to parse: {exc}",
        file=sys.stderr,
    )
    sys.exit(1)

# ---------------------------------------------------------------------------
# Guard (a): stdlib-only import allowlist (rejection list)
# ---------------------------------------------------------------------------
def _root(name: str) -> str:
    return name.split(".", 1)[0] if name else ""

violations: list[str] = []
for node in ast.walk(install_core_tree):
    if isinstance(node, ast.Import):
        for alias in node.names:
            root = _root(alias.name)
            if root in FORBIDDEN_ROOTS:
                violations.append(
                    f"  line {node.lineno}: import {alias.name} (forbidden root '{root}')"
                )
    elif isinstance(node, ast.ImportFrom):
        # ImportFrom with module=None is a relative `from . import x`; treat
        # the bare relative form as allowed (no root to reject).
        if node.module is None:
            continue
        root = _root(node.module)
        if root in FORBIDDEN_ROOTS:
            names = ", ".join(alias.name for alias in node.names)
            violations.append(
                f"  line {node.lineno}: from {node.module} import {names} (forbidden root '{root}')"
            )

if violations:
    print(
        "pre-commit: install_core.py imports a forbidden module.\n"
        "install_core.py must be stdlib-only (plus the sibling install_guard\n"
        "and cli_pin modules) so the bare-stdlib hook Python can load it\n"
        "without resolving the plugin's PEP 723 deps. Offending import(s):",
        file=sys.stderr,
    )
    for v in violations:
        print(v, file=sys.stderr)
    sys.exit(1)

# ---------------------------------------------------------------------------
# Guard (b): _enforce_plugin_root byte-identity (whitespace normalized via
# ast.unparse) between server.py and install_core.py.
# ---------------------------------------------------------------------------
if not SERVER.exists():
    # server.py absent — skip parity guard (install_core stdlib check already ran).
    sys.exit(0)

server_src = SERVER.read_text(encoding="utf-8")
try:
    server_tree = ast.parse(server_src, filename=str(SERVER))
except SyntaxError as exc:
    print(
        f"pre-commit: server.py failed to parse: {exc}",
        file=sys.stderr,
    )
    sys.exit(1)

def _find_function(tree: ast.Module, name: str) -> ast.FunctionDef | None:
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and node.name == name:
            return node
    return None

server_fn = _find_function(server_tree, "_enforce_plugin_root")
install_core_fn = _find_function(install_core_tree, "_enforce_plugin_root")

if server_fn is None:
    print(
        "pre-commit: _enforce_plugin_root not found at module top level in\n"
        "plugins/cortex-overnight/server.py — the parity guard cannot run.",
        file=sys.stderr,
    )
    sys.exit(1)

if install_core_fn is None:
    print(
        "pre-commit: _enforce_plugin_root not found at module top level in\n"
        "plugins/cortex-overnight/install_core.py — per spec R10 this\n"
        "function must be duplicated from server.py.",
        file=sys.stderr,
    )
    sys.exit(1)

server_unparsed = ast.unparse(server_fn)
install_core_unparsed = ast.unparse(install_core_fn)

if server_unparsed != install_core_unparsed:
    print(
        "pre-commit: _enforce_plugin_root has drifted between\n"
        "plugins/cortex-overnight/server.py and\n"
        "plugins/cortex-overnight/install_core.py.\n"
        "These copies must stay byte-identical (modulo whitespace inside\n"
        "the body, normalized via ast.unparse). Update both copies\n"
        "together or revert the divergent change.",
        file=sys.stderr,
    )
    sys.exit(1)

sys.exit(0)
PYEOF
    then
        exit 1
    fi
fi


# -----------------------------------------------------------------------------
# Phase 2 — Short-circuit decision
# -----------------------------------------------------------------------------
# D is included deliberately: a commit that only deletes a mirrored source must
# still trigger the rebuild, or its mirror is orphaned in the tree.
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
BUILD_NEEDED=0

if echo "$staged" | grep -qE '^(skills/|bin/cortex-|hooks/cortex-|claude/hooks/cortex-)'; then
    BUILD_NEEDED=1
fi

if [ "$BUILD_NEEDED" -eq 0 ]; then
    while read -r p; do
        [ -z "$p" ] && continue
        if echo "$staged" | grep -qE "^plugins/$p/"; then
            BUILD_NEEDED=1
            break
        fi
    done < <(just _list-build-output-plugins)
fi

# -----------------------------------------------------------------------------
# Phase 3 — Staged-blob mirror reconciliation
# -----------------------------------------------------------------------------
# Rebuilds the plugin mirrors from the STAGED blobs — never the working tree —
# and folds the result into this commit. Building from the staged tree is what
# makes concurrent sessions safe: a sibling's uncommitted edits are absent from
# this commit's index, so they can reach neither the mirrors nor the commit, and
# the hook writes no source file in the shared working tree.
#
# This replaces the former Phase 3 (rebuild into the working tree) and Phase 4
# (working-tree-vs-index drift block). That pair compared the wrong things: it
# fired on a sibling session's unrelated edits, and under `git commit --only`
# it degenerated to working-tree-vs-HEAD. It was also the only mechanism putting
# rebuilt mirrors into a commit, so it could not simply be deleted.
#
# Under `--only`, git holds .git/index.lock for the whole hook, so only its
# temporary index is writable here; `.githooks/post-commit` resyncs the real
# index afterwards. Without that companion, `git status` retains a stale mirror
# blob that reads as a staged reversion.
if [ "$BUILD_NEEDED" -eq 1 ]; then
    TMP="$(mktemp -d)"
    trap 'rm -rf "$TMP"' EXIT

    if ! git ls-files -z -- skills bin hooks claude/hooks plugins justfile \
        | git checkout-index --prefix="$TMP/" -z --stdin; then
        echo "pre-commit: could not materialise the staged tree for the mirror rebuild." >&2
        exit 1
    fi

    # The mirror file set before the rebuild is exactly the staged one. Diffing
    # it against the set after tells us which paths `build-plugin` owns, so the
    # justfile's SKILLS/HOOKS/BIN manifest is never duplicated here — and files
    # under plugins/ that it does not write (cli_pin.py, server.py, .mcp.json,
    # install_guard.py) appear in both sets unchanged and are left alone.
    before="$(cd "$TMP" && find plugins -type f 2>/dev/null | LC_ALL=C sort)"
    if ! ( cd "$TMP" && just build-plugin >/dev/null 2>&1 ); then
        echo "pre-commit: 'just build-plugin' failed on the staged tree." >&2
        ( cd "$TMP" && just build-plugin >&2 ) || true
        exit 1
    fi
    after="$(cd "$TMP" && find plugins -type f 2>/dev/null | LC_ALL=C sort)"

    reconciled=0
    record="$(git rev-parse --git-dir)/cortex-reconciled"
    : > "$record"

    # Mirrors the rebuild created or changed.
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        newhash="$(git hash-object -w -- "$TMP/$rel")"
        oldhash="$(git rev-parse ":$rel" 2>/dev/null || true)"
        [ "$newhash" = "$oldhash" ] && continue
        # Preserve the executable bit: bin/cortex-* and hooks/*.sh mirrors are
        # mode 100755, and flattening them to 100644 would ship broken plugins.
        if [ -x "$TMP/$rel" ]; then mode=100755; else mode=100644; fi
        git update-index --add --cacheinfo "$mode,$newhash,$rel"
        mkdir -p "$(dirname "$rel")"
        cp -p "$TMP/$rel" "$rel"
        printf '%s\n' "$rel" >> "$record"
        reconciled=$((reconciled + 1))
        echo "    $rel" >&2
    done <<< "$after"

    # Mirrors the rebuild removed, because their canonical source is deleted in
    # this commit. Without this the mirror is orphaned in HEAD.
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        git update-index --force-remove -- "$rel"
        rm -f "$rel"
        printf '%s\n' "$rel" >> "$record"
        reconciled=$((reconciled + 1))
        echo "    $rel (removed)" >&2
    done < <(comm -23 <(printf '%s\n' "$before") <(printf '%s\n' "$after"))

    if [ "$reconciled" -gt 0 ]; then
        echo "pre-commit: reconciled $reconciled plugin-mirror file(s) into this commit." >&2
    else
        rm -f "$record"
    fi
fi

exit 0
